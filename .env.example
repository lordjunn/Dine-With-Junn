# Dine with Junn V2 - Environment Configuration
# Copy this file to .env and fill in your private credentials.

# Discord Bot Credentials (for batch photo synchronization)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_private_channel_id_here

# Local Review Web Server Port
REVIEW_SERVER_PORT=8000

# Optional: External HDD Sync Path
HDD_PATH=

